uniform float4x4 ViewProj;
uniform texture2d image;
uniform float pixel_size;
uniform float2 source_size;

sampler_state textureSampler {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData input)
{
	VertData output;
	output.pos = mul(float4(input.pos.xyz, 1.0), ViewProj);
	output.uv = input.uv;
	return output;
}

float4 PSPixelate(VertData input) : TARGET
{
	float2 blocks = source_size / max(pixel_size, 1.0);
	float2 block_index = floor(input.uv * blocks) + 0.5;
	float2 sample_uv = block_index / blocks;
	return image.Sample(textureSampler, sample_uv);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(input);
		pixel_shader = PSPixelate(input);
	}
}
